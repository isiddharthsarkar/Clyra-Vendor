# --- ROM archives and extraction workspace ---------------------------------
# A single ruan fastboot archive is ~5 GiB and super.img expands to ~9 GiB.
# None of this belongs in git — only the *extracted* blobs get published.
build/
*.tgz
*.tgz.partial
*.zip
*.img
*.unsparse.img
!tools/vendor/*.img

# --- generated vendor staging tree -----------------------------------------
# The authoritative per-partition list lives in vendor/.gitignore, which
# scripts/extract-vendor.sh regenerates after every run.
/vendor/*
!/vendor/.gitignore

# --- tooling noise ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
